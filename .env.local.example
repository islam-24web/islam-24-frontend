# ─── Strapi CMS ──────────────────────────────────────────────────────
# Base URL of your Strapi instance (no trailing slash)
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Optional: Strapi API Token for authenticated requests
# Generate at: Strapi Admin → Settings → API Tokens
STRAPI_API_TOKEN=

# Optional: Hostname for Strapi media (for next.config.js image optimization)
STRAPI_MEDIA_HOST=localhost

# ─── Site Config ─────────────────────────────────────────────────────
# Your frontend production URL (used for sitemap, OG tags, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site name shown in metadata and structured data
NEXT_PUBLIC_SITE_NAME=MySite

# ─── Jobs MVP — Sync Worker (Phase 2) ────────────────────────────────
# Optional override of NEXT_PUBLIC_STRAPI_URL for the server-side worker
# (e.g. when worker hits Railway prod while frontend uses localhost).
# Falls back to NEXT_PUBLIC_STRAPI_URL when empty.
STRAPI_URL=

# Gemini 2.5 Flash for English → Arabic job translation
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Cron handler authorization. Vercel auto-injects this header on production
# crons; in dev set it here and pass it via:
#   curl -H "Authorization: Bearer <secret>" http://localhost:3000/api/cron/sync-remoteok
CRON_SECRET=

# Per-sync translation cap (cost circuit breaker). Default 25.
MAX_TRANSLATIONS_PER_SYNC=25
